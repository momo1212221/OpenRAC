// Five-by-five Gaussian reduction; the first level selects bright samples before filtering.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) writeonly buffer BloomOutput { uint pixels[]; };
uniform sampler2D tex_T0;
uniform vec2 source_size;
uniform int first_pass;
uniform float threshold;
uniform float knee;
uniform int bloom_precision16;

ivec2 source_dims() {
    return ivec2(source_size);
}

vec3 tap(ivec2 p) {
    ivec2 size = source_dims();
    vec3 colour = texelFetch(tex_T0, clamp(p, ivec2(0), size - 1), 0).rgb;
    if (first_pass != 0) {
        // Select bright pixels before filtering. Filtering the 5x5 neighbourhood first
        // diluted small lamps and narrow emissive edges below the threshold entirely.
        // RGB-only fallback until material-ID emission exists. Avoid green
        // foliage overbloom while preserving narrow red/blue light cores.
        float luminance = dot(max(colour, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        float peak = max(colour.r, max(colour.g, colour.b));
        float brightness = max(luminance, peak * (1.0 - 0.45 * clamp(luminance, 0.0, 1.0)));
        float soft = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
        soft = soft * soft / max(4.0 * knee, 1e-5);
        float contribution = max(brightness - threshold, soft) / max(brightness, 1e-5);
        colour *= max(contribution, 0.0);
    }
    return colour;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = (source_dims() + 1) / 2;
    if (any(greaterThanEqual(p, size))) {
        return;
    }

    const float weights[5] = float[5](1.0, 4.0, 6.0, 4.0, 1.0);
    ivec2 centre = p * 2;
    vec3 colour = vec3(0.0);
    for (int y = 0; y < 5; ++y) {
        for (int x = 0; x < 5; ++x) {
            colour += tap(centre + ivec2(x - 2, y - 2)) * weights[x] * weights[y];
        }
    }
    colour *= 1.0 / 256.0;

    vec3 radiance = clamp(colour, vec3(0.0), vec3(16.0));
    uint at = uint(p.y * size.x + p.x);
    if (bloom_precision16 != 0) {
        pixels[at * 2u] = packHalf2x16(radiance.rg);
        pixels[at * 2u + 1u] = packHalf2x16(vec2(radiance.b, 1.0));
    } else {
        pixels[at] = packUnorm4x8(vec4(clamp(radiance, 0.0, 1.0), 1.0));
    }
}
